{
  "compilerOptions": {
    "strict": true,
    "target": "es2024",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "contentMappers": [{ "package": "../..", "extensions": [".md"] }],
  "include": ["registry.ts", "valid.md", "invalid.md", "untitled.md"]
}
