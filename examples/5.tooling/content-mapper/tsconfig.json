{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "contentMappers": [
    {
      "package": "@comark/content-mapper",
      "extensions": [".md"]
    }
  ],
  "include": ["components.ts", "content"]
}
